{
  "info": {
    "_postman_id": "b7f2c1a4-9d3e-4f6a-8c2b-1e5d7a9c3f01",
    "name": "App Perpustakaan API",
    "description": "Collection API app-perpustakaan (Laravel).\n\nBase URL default: http://127.0.0.1:8000/api\nUbah nilai variable `baseUrl` jika port php artisan serve berbeda.\n\nSemua request otomatis memakai header `Accept: application/json` (dipasang lewat pre-request script collection) agar Laravel selalu merender response/error dalam bentuk JSON.\n\nVariable ID (bookId, memberId, loanId, userId, categoryId) bisa diisi manual atau otomatis terisi setelah request Create Book / Create Loan berhasil.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "loanId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Stats",
      "item": [
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats"
              ]
            },
            "description": "Mengambil total buku, total anggota, dan jumlah peminjaman aktif."
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books?judul=&category_id=&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "judul",
                  "value": "",
                  "description": "Filter judul (like)",
                  "disabled": true
                },
                {
                  "key": "category_id",
                  "value": "{{categoryId}}",
                  "description": "Filter berdasarkan kategori",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Halaman (10 data per halaman)",
                  "disabled": true
                }
              ]
            },
            "description": "Daftar buku dengan pagination 10 per halaman."
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const data = body.data || body;",
                  "if (data.id) {",
                  "    pm.collectionVariables.set('bookId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Belajar Laravel 12\",\n  \"penulis\": \"John Doe\",\n  \"penerbit\": \"Andi Publisher\",\n  \"tahun_terbit\": 2026,\n  \"isbn\": \"9781234567890\",\n  \"stok\": 10,\n  \"category_id\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "Field wajib: judul, penulis, penerbit, tahun_terbit, stok, category_id. `category_id` harus ada di tabel categories."
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Belajar Laravel 12 (Edisi Revisi)\",\n  \"penulis\": \"John Doe\",\n  \"penerbit\": \"Andi Publisher\",\n  \"tahun_terbit\": 2026,\n  \"isbn\": \"9781234567890\",\n  \"stok\": 8,\n  \"category_id\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Get All Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/members?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Halaman (10 data per halaman)",
                  "disabled": true
                }
              ]
            },
            "description": "Daftar anggota dengan pagination 10 per halaman."
          }
        },
        {
          "name": "Get Member by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "Get All Loans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Halaman (10 data per halaman)",
                  "disabled": true
                }
              ]
            },
            "description": "Daftar peminjaman beserta member, petugas, dan buku."
          }
        },
        {
          "name": "Create Loan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const data = body.data || body;",
                  "if (data.id) {",
                  "    pm.collectionVariables.set('loanId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": {{memberId}},\n  \"user_id\": {{userId}},\n  \"tanggal_pinjam\": \"2026-10-30\",\n  \"tanggal_kembali\": \"2026-11-06\",\n  \"book_ids\": [{{bookId}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans"
              ]
            },
            "description": "Field wajib: member_id, user_id, tanggal_pinjam, tanggal_kembali, book_ids (array, minimal 1)."
          }
        },
        {
          "name": "Return Loan (Kembalikan)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/kembalikan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "kembalikan"
              ]
            },
            "description": "Mengubah status peminjaman menjadi `dikembalikan` dan mengisi tanggal_dikembalikan."
          }
        }
      ]
    }
  ]
}
